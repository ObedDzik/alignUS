# Copy this file to .env and fill in the values for your own machine/cluster.
# .env is gitignored -- it's where your real, local paths live; this file
# (.env.example) is the only one that gets committed/pushed.
#
# Every training/launch script in this repo sources .env before running, so
# nothing needs to be edited in train.sh/debug.sh/cfgs/*.yaml themselves.
#
# See README.md's "Data" section for what each of these paths/files is
# expected to contain and how it should be laid out.

# ----- Checkpoints -----

# Where trained checkpoints get written. Used as `base_dir` in every cfg;
# each run creates CHECKPOINT/<project>/<run_name>/<job_id>/{best.pth,...}.
CHECKPOINT=/path/to/your/checkpoint/output/dir

# ----- Backbone checkpoints -----

# MedSAM / SAM checkpoint directory and file (medsam backbone).
MEDSAM_CHECKPOINT_DIR=/path/to/checkpoint_store
MEDSAM_CHECKPOINT=/path/to/checkpoint_store/sam/medsam_vit_b_cpu.pth

# MicroSegNet pretrained checkpoint (microsegnet baseline only).
MICROSEGNET_CHECKPOINT=/path/to/MicroSegNet.pth

# DINOv3: the dinov3 source library (github.com/facebookresearch/dinov3,
# imported for its model-building code) and where its pretrained
# checkpoints live.
DINOV3_LIBRARY_PATH=/path/to/dinov3
DINOV3_CHECKPOINTS_PATH=/path/to/dinov3_checkpoints

# ----- Micro-ultrasound data -----

# NCT2013 cohort: raw B-mode data directory + metadata CSV.
NCT_RAW_DATA_DIR=/path/to/nct2013
NCT_METADATA_PATH=/path/to/nct2013/metadata.csv

# OPTIMUM cohort root. root_dir_c23/root_dir_c3 in the cfgs resolve to
# subdirectories under this (see README.md's Data section for the exact
# expected layout).
EXACTVU_PCA_DATA_ROOT=/path/to/exactvu_pca_root

# ----- Histopathology (GigaPath) data -----

# Directory of per-slide .npz embeddings, and the metadata CSV linking
# slide/image IDs to ISUP grade and cancer percentage.
HISTO_EMB_DIR=/path/to/histo_embeddings
HIST_CSV=/path/to/histo_metadata.csv

# Directory holding metadata.csv (general core metadata) and
# panda_split/train.csv (PANDA train/test split) -- siblings of HIST_CSV.
USALIGN_METADATA_DIR=/path/to/metadata_dir

# ----- MRI data (only used by a subset of ablations) -----

MRI_EMB_DIR=/path/to/mri_embeddings
MRI_CSV=/path/to/mri_manifest.csv

# ----- Weights & Biases -----

WANDB_API_KEY=your_wandb_api_key_here
